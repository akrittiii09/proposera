# ==============================================================================
# PROPOSERA ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# This file serves as the canonical reference for environment configuration.
# Copy this file to .env.local for local development.
# NEVER commit actual secrets, credentials, or API keys into source control.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SQLite Database File Path (defaults to ./data/proposera.sqlite in production, or in-memory in tests)
# DATABASE_PATH=./data/proposera.sqlite

# ==============================================================================
# Razorpay Payment Gateway & Creator Paywall (Milestone 6)
# ==============================================================================
# Server-side keys for creating orders and verifying cryptographic signatures
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Webhook signing secret (Configured in Razorpay Dashboard > Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Public Key ID exposed to the browser for Razorpay Checkout Modal
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Creator Lifetime Proposal Publishing Price in INR (default: 499)
PROPOSERA_PRICE_INR=499

# Future Server Secret Categories (Planned for later phases)
# AUTH_SECRET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=
# STORAGE_ENDPOINT=
